<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- PriceCharting graded-price crawl (2026-10-29). Runs through the day
	     alongside the sales-volume crawl: that one talks to TCGplayer and
	     this one to PriceCharting, so their politeness budgets are separate.
	     It DOES pause for the nightly refresh, whose own pc-graded-new step
	     hits this same host — two crawls against PriceCharting at once is
	     what got this IP blocked for two days on 2026-10-12. Relaunched
	     hourly; a flock keeps runs from overlapping. -->
	<key>Label</key>
	<string>com.tcg-predictor.graded-crawl</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-i</string>
		<string>/Users/nicholasgonzalez/Developer/Projects/parent/one-piece/.venv/bin/python</string>
		<string>/Users/nicholasgonzalez/Developer/Projects/parent/tcg-predictor/pipeline/scrape_graded_history.py</string>
		<string>--game</string>
		<string>all</string>
		<string>--resume</string>
		<string>--workers</string>
		<string>2</string>
		<string>--delay</string>
		<string>1.0</string>
		<string>--refresh-days</string>
		<string>90</string>
		<string>--fast-tier-price</string>
		<string>5</string>
		<string>--fast-refresh-days</string>
		<string>30</string>
		<string>--yield-to-refresh</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/nicholasgonzalez/Developer/Projects/parent/tcg-predictor/pipeline</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>StandardOutPath</key>
	<string>/Users/nicholasgonzalez/Library/Logs/tcg-predictor/graded-crawl.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/nicholasgonzalez/Library/Logs/tcg-predictor/graded-crawl.log</string>
</dict>
</plist>
