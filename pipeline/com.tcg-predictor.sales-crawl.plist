<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TCGplayer sales-volume crawl (2026-10-28): the backfill of every
	     priced card's year of weekly sales, then maintenance (cards $5+
	     weekly, the rest monthly). Relaunched hourly; the script holds a
	     lock so runs never overlap, and it pauses itself for as long as
	     the nightly refresh is running so TCGplayer only ever sees one
	     crawl from this machine. caffeinate keeps the Mac from idle-
	     sleeping while it works; the lid still has to stay open. -->
	<key>Label</key>
	<string>com.tcg-predictor.sales-crawl</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-i</string>
		<string>/Users/nicholasgonzalez/Developer/Projects/parent/one-piece/.venv/bin/python</string>
		<string>/Users/nicholasgonzalez/Developer/Projects/parent/tcg-predictor/pipeline/backfill_sales_volume.py</string>
		<string>--game</string>
		<string>all</string>
		<string>--rpm</string>
		<string>40</string>
		<string>--refresh-days</string>
		<string>30</string>
		<string>--fast-tier-price</string>
		<string>5</string>
		<string>--fast-refresh-days</string>
		<string>7</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/nicholasgonzalez/Developer/Projects/parent/tcg-predictor/pipeline</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>StandardOutPath</key>
	<string>/Users/nicholasgonzalez/Library/Logs/tcg-predictor/sales-crawl.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/nicholasgonzalez/Library/Logs/tcg-predictor/sales-crawl.log</string>
</dict>
</plist>
