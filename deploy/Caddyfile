# TCG Predictor — cardstock.guide. Caddy fetches + renews Let's Encrypt certs
# automatically (HTTP-01 challenge on :80) and redirects HTTP -> HTTPS.
# handle blocks are mutually exclusive — the SPA's try_files can't swallow
# /api/* (try_files is a rewrite and would otherwise run before the proxy).
# The API behind every proxied path. A deploy restarts it (2026-11-13: a
# portfolio page click landed in that window, got a 502, and the pager looked
# dead): while it is down Caddy keeps retrying the connection for up to 45 s
# instead of answering 502 at once, so a restart only makes requests slower.
(api) {
	reverse_proxy 127.0.0.1:5000 {
		lb_try_duration 45s
		lb_try_interval 500ms
	}
}

# Who counts as a crawler (2026-11-24). Search engines, the AI assistants'
# crawlers AND their live fetchers, and the link previewers. Until this date
# the list knew GPTBot, ClaudeBot and PerplexityBot (the training crawlers)
# but not OAI-SearchBot, ChatGPT-User, Claude-User, Perplexity-User or
# Applebot: the ones that fetch a page when someone asks an assistant about a
# card. None of them runs JavaScript, so each got the empty app shell, with
# the home page's title and canonical link, for every card page on the site.
(crawler) {
	header_regexp ua User-Agent (?i)(googlebot|google-inspectiontool|googleother|storebot-google|adsbot|mediapartners|apis-google|bingbot|bingpreview|msnbot|slurp|duckduckbot|duckassistbot|baiduspider|yandex|applebot|amazonbot|petalbot|seznambot|yeti|naverbot|kagibot|ia_archiver|archive\.org_bot|gptbot|oai-searchbot|chatgpt|claudebot|claude-user|claude-searchbot|claude-web|anthropic-ai|perplexity|meta-externalagent|meta-externalfetcher|facebookexternalhit|facebookcatalog|bytespider|ccbot|cohere-ai|mistralai|youbot|phindbot|diffbot|ai2bot|timpibot|twitterbot|linkedinbot|discordbot|slackbot|slack-imgproxy|telegrambot|whatsapp|redditbot|pinterestbot|bluesky|mastodon|skypeuripreview|embedly|iframely|ahrefsbot|semrushbot|mj12bot|dotbot|rogerbot|screaming.frog)
}

# Nothing answers on http://www before two redirects (http -> https://www ->
# the apex) unless it is told to.
http://www.cardstock.guide {
	redir https://cardstock.guide{uri} permanent
}

cardstock.guide {
	encode gzip

	# One address per page (2026-11-24): /catalog/onepiece/123/ used to answer
	# 200 with the app shell, a second URL for the same page. The query
	# string rides along (a utm tag on a shared link must survive).
	@slash {
		path_regexp slash ^(.+)/$
		expression {http.request.uri.query} == ""
	}
	redir @slash {re.slash.1} 308
	@slashq {
		path_regexp slashq ^(.+)/$
		expression {http.request.uri.query} != ""
	}
	redir @slashq {re.slashq.1}?{http.request.uri.query} 308

	# Access log (2026-10-27): the only record of who visits and what they
	# read — nothing was logged before, so every visit was lost. Caddy rolls
	# the file itself (no logrotate entry needed). JSON because
	# deploy/traffic_report.py parses it. Single-page-app navigation makes no
	# document request, so the API calls ARE the page views and the report
	# maps them back to pages.
	log {
		output file /var/log/caddy/access.log {
			roll_size 64MiB
			roll_keep 8
			roll_keep_for 2160h
		}
		format json
	}

	handle /api/* {
		import api
	}

	handle /card-images/* {
		import api
	}

	# First-party page-view beacon (2026-10-27). The site is a single-page
	# app, so moving from a card to the catalog makes NO document request
	# and the access log alone undercounts badly. The client pings this on
	# every route change; Caddy answers 204 here, so the API never sees it,
	# and the hit lands in the same access log deploy/traffic_report.py
	# already reads. No cookie, no third party, no database write.
	handle /px {
		respond 204
	}

	@sitemaps path /sitemap.xml /sitemap-*.xml
	handle @sitemaps {
		import api
	}

	# Crawler-visible static pages (2026-08-29, AdSense "low value content"
	# fix): weekly reports + guides exist as real HTML in /srv/tcg/static —
	# served file-first, so /reports/{slug} and /guides/{name} work without
	# JavaScript. Anything without a file falls through to the SPA.
	# /sets is sets/index.html (2026-11-24): the set index existed on disk but
	# nothing routed to it, so the "Sets" link in every static page's menu
	# opened the app's not-found page.
	# /guides is guides/index.html the same way (the app has no guides page).
	@static-pages {
		path /reports/* /articles/* /guides /guides/* /sets /sets/*
		file {
			root /srv/tcg/static
			try_files {path}.html {path}/index.html {path}
		}
	}
	handle @static-pages {
		root * /srv/tcg/static
		try_files {path}.html {path}/index.html {path}
		file_server
	}

	# Dynamic rendering for crawlers (2026-09-26): bots receive prerendered
	# static HTML at the SAME URLs — equivalent content, regenerated on this
	# box by /srv/tcg/prerender_pages.py after every data push. Humans get
	# the SPA. Pages without a prerender file fall through to the SPA.
	@bots {
		import crawler
		path / /about /privacy /terms /contact /catalog /catalog/* /reports /articles /guides
		file {
			root /srv/tcg/static
			try_files /prerender{path}.html /prerender{path}index.html
		}
	}
	handle @bots {
		root * /srv/tcg/static
		rewrite {http.matchers.file.relative}
		file_server
	}

	# Hashed build assets (2026-11-09): cache for good, and a missing one is
	# a 404. It used to fall through to the SPA page below, so a browser
	# holding a stale index.html got HTML back for its old bundle, with a
	# 200, and showed a dead page after every deploy.
	handle /assets/* {
		root * /srv/tcg/client
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv/tcg/client
		# The page shell names the current bundle, so browsers must check it
		# every time (an ETag makes that a cheap 304); the site's own icons
		# and images can keep their default caching.
		@shell not path /images/* /favicon* /apple-touch-icon.png /og-image.png /icons.svg /robots.txt /ads.txt /llms.txt /promo/*
		header @shell Cache-Control "no-cache"
		# A crawler that reaches this point with a path that is no file is
		# about to get the app shell: a page with no content of its own. That
		# is every address that does not exist (/catalog/999999999 answered
		# 200) and every card with no price to show. Tell it not to index
		# what it got; real pages were answered above with their own HTML.
		@crawler-shell {
			import crawler
			not file {
				root /srv/tcg/client
				try_files {path}
			}
		}
		header @crawler-shell X-Robots-Tag "noindex"
		try_files {path} /index.html
		file_server
	}
}

# Canonical host is the apex; send www there.
www.cardstock.guide {
	redir https://cardstock.guide{uri} permanent
}
