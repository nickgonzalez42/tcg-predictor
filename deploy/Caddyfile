# TCG Predictor — cardstock.guide. Caddy fetches + renews Let's Encrypt certs
# automatically (HTTP-01 challenge on :80) and redirects HTTP -> HTTPS.
# handle blocks are mutually exclusive — the SPA's try_files can't swallow
# /api/* (try_files is a rewrite and would otherwise run before the proxy).
cardstock.guide {
	encode gzip

	# Access log (2026-10-27): the only record of who visits and what they
	# read — nothing was logged before, so every visit was lost. Caddy rolls
	# the file itself (no logrotate entry needed). JSON because
	# deploy/traffic_report.py parses it. Single-page-app navigation makes no
	# document request, so the API calls ARE the page views and the report
	# maps them back to pages.
	log {
		output file /var/log/caddy/access.log {
			roll_size 64MiB
			roll_keep 8
			roll_keep_for 2160h
		}
		format json
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:5000
	}

	handle /card-images/* {
		reverse_proxy 127.0.0.1:5000
	}

	# First-party page-view beacon (2026-10-27). The site is a single-page
	# app, so moving from a card to the catalog makes NO document request
	# and the access log alone undercounts badly. The client pings this on
	# every route change; Caddy answers 204 here, so the API never sees it,
	# and the hit lands in the same access log deploy/traffic_report.py
	# already reads. No cookie, no third party, no database write.
	handle /px {
		respond 204
	}

	@sitemaps path /sitemap.xml /sitemap-*.xml
	handle @sitemaps {
		reverse_proxy 127.0.0.1:5000
	}

	# Crawler-visible static pages (2026-08-29, AdSense "low value content"
	# fix): weekly reports + guides exist as real HTML in /srv/tcg/static —
	# served file-first, so /reports/{slug} and /guides/{name} work without
	# JavaScript. Anything without a file falls through to the SPA.
	@static-pages {
		path /reports/* /guides/* /sets /sets/*
		file {
			root /srv/tcg/static
			try_files {path}.html {path}
		}
	}
	handle @static-pages {
		root * /srv/tcg/static
		try_files {path}.html {path}
		file_server
	}

	# Dynamic rendering for crawlers (2026-09-26): bots receive prerendered
	# static HTML at the SAME URLs — equivalent content, regenerated on this
	# box by /srv/tcg/prerender_pages.py after every data push. Humans get
	# the SPA. Pages without a prerender file fall through to the SPA.
	@bots {
		header_regexp ua User-Agent (?i)(googlebot|adsbot|mediapartners|apis-google|bingbot|slurp|duckduckbot|baiduspider|yandexbot|facebookexternalhit|twitterbot|linkedinbot|gptbot|ccbot|claudebot|perplexitybot|discordbot|slackbot|telegrambot|whatsapp|redditbot|pinterestbot)
		path / /about /privacy /terms /contact /catalog /catalog/* /reports /guides
		file {
			root /srv/tcg/static
			try_files /prerender{path}.html /prerender{path}index.html
		}
	}
	handle @bots {
		root * /srv/tcg/static
		rewrite {http.matchers.file.relative}
		file_server
	}

	handle {
		root * /srv/tcg/client
		try_files {path} /index.html
		file_server
	}
}

# Canonical host is the apex; send www there.
www.cardstock.guide {
	redir https://cardstock.guide{uri} permanent
}
